# --- Servidor ---
PORT=3000
SESSION_SECRET=un_secreto_muy_seguro_cambiar_en_produccion

# --- Base de datos PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=fundacion_soy
PGUSER=postgres
PGPASSWORD=postgres

# --- ARCA (WSAA / WSFE) ---
# ambiente: mock | homologacion | produccion
# - mock: no llama a ARCA, genera CAE simulados. Usar mientras no haya certificado.
# - homologacion: apunta a los WSDL de testing de ARCA (Fase 2).
# - produccion: apunta a los WSDL reales (Fase 3).
ARCA_AMBIENTE=mock

ARCA_CUIT_EMISOR=
ARCA_PUNTO_VENTA=
ARCA_CBTE_TIPO_DEFAULT=11

# Rutas al certificado y clave privada (fuera del repo, nunca versionados)
ARCA_CERT_PATH=./secrets/arca.crt
ARCA_KEY_PATH=./secrets/arca.key

# --- Archivos ---
UPLOADS_DIR=./uploads
FACTURAS_DIR=./storage/facturas
