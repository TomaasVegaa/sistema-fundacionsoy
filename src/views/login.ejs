<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iniciar sesión — Fundación Soy</title>
  <link rel="stylesheet" href="/public/css/styles.css">
  <style>
    body.login-page {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%);
      margin: 0;
      padding: 20px;
    }
    .login-container {
      width: 100%;
      max-width: 420px;
    }
    .login-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 38px 34px;
      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.07), 0 8px 10px -6px rgba(15, 23, 42, 0.04);
    }
    .login-header {
      text-align: center;
      margin-bottom: 28px;
    }
    .brand-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 54px;
      height: 54px;
      background: linear-gradient(135deg, #1e293b, #0f172a);
      border-radius: 14px;
      box-shadow: 0 6px 14px rgba(15, 23, 42, 0.15);
      margin-bottom: 16px;
    }
    .login-title {
      font-family: var(--serif);
      font-size: 26px;
      font-weight: 700;
      color: #0f172a;
      margin: 0 0 6px;
    }
    .login-subtitle {
      font-size: 13.5px;
      color: #64748b;
      margin: 0;
    }
    .login-field {
      margin-bottom: 20px;
    }
    .login-field label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #334155;
      margin-bottom: 7px;
    }
    .login-field input {
      width: 100%;
      box-sizing: border-box;
      font-family: var(--sans);
      font-size: 14.5px;
      padding: 11px 14px;
      border: 1px solid #cbd5e1;
      background: #ffffff;
      border-radius: 8px;
      color: #0f172a;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .login-field input:focus {
      outline: none;
      border-color: #b45309;
      box-shadow: 0 0 0 3.5px rgba(180, 83, 9, 0.15);
    }
    .login-btn {
      width: 100%;
      padding: 12px;
      font-family: var(--sans);
      font-size: 15px;
      font-weight: 600;
      color: #ffffff;
      background: linear-gradient(135deg, #d97706, #b45309);
      border: none;
      border-radius: 8px;
      cursor: pointer;
      box-shadow: 0 4px 10px rgba(180, 83, 9, 0.25);
      transition: all 0.2s ease;
      margin-top: 6px;
    }
    .login-btn:hover {
      background: linear-gradient(135deg, #b45309, #92400e);
      box-shadow: 0 6px 14px rgba(180, 83, 9, 0.35);
      transform: translateY(-1px);
    }
    .login-error {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #991b1b;
      padding: 12px 16px;
      border-radius: 8px;
      font-size: 13.5px;
      margin-bottom: 22px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .login-footer {
      text-align: center;
      font-size: 12px;
      color: #94a3b8;
      margin-top: 22px;
    }
    @media (max-width: 480px) {
      body.login-page {
        padding: 16px;
      }
      .login-card {
        padding: 26px 20px;
        border-radius: 12px;
      }
      .login-title {
        font-size: 22px;
      }
    }
  </style>
</head>
<body class="login-page">
  <div class="login-container">
    <div class="login-card">
      <div class="login-header">
        <div class="brand-icon">
          <svg width="26" height="26" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 8h24M4 16h24M4 24h16" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="26" cy="24" r="3" stroke="#f59e0b" stroke-width="2.5"/>
          </svg>
        </div>
        <h1 class="login-title">Fundación Soy</h1>
        <p class="login-subtitle">Sistema de Facturación & Control de Caja</p>
      </div>

      <% if (error) { %>
        <div class="login-error">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/login">
        <div class="login-field">
          <label for="usuario">Usuario</label>
          <input type="text" name="usuario" id="usuario" required autofocus placeholder="fundacionsoy" autocomplete="username">
        </div>
        <div class="login-field">
          <label for="password">Contraseña</label>
          <input type="password" name="password" id="password" required placeholder="••••••••••••" autocomplete="current-password">
        </div>
        <button type="submit" class="login-btn">Ingresar al sistema</button>
      </form>
    </div>
    <div class="login-footer">
      Fundación Soy — Acceso exclusivo para administración
    </div>
  </div>
</body>
</html>
