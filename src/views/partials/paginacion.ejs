<% if (typeof totalPaginas !== 'undefined' && totalPaginas > 1) { %>
  <nav class="pagination-nav">
    <% if (paginaActual > 1) { %>
      <a href="?<%= Object.entries({...filtros, pagina: paginaActual - 1}).filter(([,v])=>v).map(([k,v])=>`${k}=${encodeURIComponent(v)}`).join('&') %>" class="btn btn--ghost pagination-btn">← Anterior</a>
    <% } %>
    <span class="pagination-info">Página <%= paginaActual %> de <%= totalPaginas %></span>
    <% if (paginaActual < totalPaginas) { %>
      <a href="?<%= Object.entries({...filtros, pagina: paginaActual + 1}).filter(([,v])=>v).map(([k,v])=>`${k}=${encodeURIComponent(v)}`).join('&') %>" class="btn btn--ghost pagination-btn">Siguiente →</a>
    <% } %>
  </nav>
<% } %>
