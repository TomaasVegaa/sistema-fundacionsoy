<%- include('partials/header', { titulo: 'Configuración ARCA', activeNav }) %>

<div class="page-head">
  <div>
    <h1>Configuración ARCA</h1>
    <p>Datos necesarios para emitir Factura C. Mientras no haya certificado, el sistema factura en modo simulado.</p>
  </div>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div style="background:#fdf2f2; border:1px solid #f8b4b4; color:#9b1c1c; padding:12px 16px; border-radius:6px; margin-bottom:20px; font-size:14px;">
    <%= error %>
  </div>
<% } %>

<% if (typeof guardado !== 'undefined' && guardado) { %>
  <div style="background:#f0fdf4; border:1px solid #bbf7d0; color:#166534; padding:12px 16px; border-radius:6px; margin-bottom:20px; font-size:14px;">
    ✓ Configuración guardada correctamente.
  </div>
<% } %>

<% if (typeof vaciado !== 'undefined' && vaciado) { %>
  <div style="background:#f0fdf4; border:1px solid #bbf7d0; color:#166534; padding:12px 16px; border-radius:6px; margin-bottom:20px; font-size:14px;">
    ✓ Base de datos vaciada con éxito. Se eliminaron todas las donaciones, ingresos, egresos, movimientos de caja y donantes de prueba. El sistema está 100% limpio y listo para importar tu archivo.
  </div>
<% } %>

<% if (config.ambiente === 'mock') { %>
  <div class="aviso">
    El sistema está en modo <strong>simulado (mock)</strong>: genera CAE ficticios para poder probar
    todo el flujo. Cuando tengas el certificado, la clave privada y el punto de venta reales, cambiá
    el ambiente a "Homologación" para probar contra el entorno de testing de ARCA antes de pasar a producción.
  </div>
<% } %>

<form class="form-card" method="POST" action="/configuracion">
  <div class="field">
    <label for="ambiente">Ambiente</label>
    <select name="ambiente" id="ambiente">
      <option value="mock" <%= config.ambiente === 'mock' ? 'selected' : '' %>>Simulado (mock)</option>
      <option value="homologacion" <%= config.ambiente === 'homologacion' ? 'selected' : '' %>>Homologación (testing ARCA)</option>
      <option value="produccion" <%= config.ambiente === 'produccion' ? 'selected' : '' %>>Producción</option>
    </select>
  </div>
  <div class="field-row">
    <div class="field">
      <label for="cuit_emisor">CUIT de la fundación</label>
      <input type="text" name="cuit_emisor" id="cuit_emisor" value="<%= config.cuit_emisor || '' %>" placeholder="30-XXXXXXXX-X">
    </div>
    <div class="field">
      <label for="punto_venta">Punto de venta</label>
      <input type="number" name="punto_venta" id="punto_venta" value="<%= config.punto_venta || '' %>">
    </div>
  </div>
  <div class="field">
    <label for="cbte_tipo_default">Tipo de comprobante</label>
    <input type="number" name="cbte_tipo_default" id="cbte_tipo_default" value="<%= config.cbte_tipo_default || 11 %>">
  </div>
  <div class="field-row">
    <div class="field">
      <label for="certificado_path">Ruta del certificado (.crt)</label>
      <input type="text" name="certificado_path" id="certificado_path" value="<%= config.certificado_path || '' %>" placeholder="./secrets/arca.crt">
    </div>
    <div class="field">
      <label for="clave_privada_path">Ruta de la clave privada (.key)</label>
      <input type="text" name="clave_privada_path" id="clave_privada_path" value="<%= config.clave_privada_path || '' %>" placeholder="./secrets/arca.key">
    </div>
  </div>
  <button type="submit" class="btn btn--gold">Guardar configuración</button>
</form>

<div class="section" style="margin-top: 40px; border-top: 1px solid var(--paper-line); padding-top: 26px;">
  <div class="section__head">
    <h2 style="color: var(--rust);">Zona de pruebas / Reinicio de datos</h2>
  </div>
  <p style="font-size: 13.5px; color: var(--ink-soft); max-width: 640px; margin-bottom: 18px; line-height: 1.5;">
    Esta función vacía todos los registros de <strong>donaciones, facturas, ingresos financieros, egresos, movimientos de caja y donantes</strong>.
    Es ideal para limpiar los datos antes de una demostración o reunión, permitiendo subir nuevamente el mismo archivo PDF o Excel de Mercado Pago desde cero sin advertencias de transacciones duplicadas.
  </p>
  <form method="POST" action="/configuracion/vaciar-datos" onsubmit="return confirm('¿Confirmás que querés vaciar todos los ingresos, egresos, donaciones y caja? Esta acción dejará el sistema en cero para volver a cargar datos de prueba.');">
    <button type="submit" class="btn btn--ghost" style="color: #b91c1c; border-color: #fca5a5; background: #fef2f2; font-weight: 500;">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
      Vaciar ingresos, egresos y donaciones de prueba
    </button>
  </form>
</div>

<%- include('partials/footer') %>
