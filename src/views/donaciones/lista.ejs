<%- include('../partials/header', { titulo: 'Donaciones', activeNav }) %>

<% if (filtros && filtros.procesado) { %>
  <div style="background: #eef8f3; border: 1px solid #c2e9d2; color: #1e5a3a; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px;">
    Lote procesado: <strong><%= filtros.ok || 0 %></strong> donación(es) facturada(s) con éxito
    <% if (Number(filtros.error) > 0) { %>, <strong><%= filtros.error %></strong> con error (podés reintentarlas con el botón Reintentar o pulsando Facturar pendientes)<% } %>.
  </div>
<% } else if (filtros && filtros.en_proceso) { %>
  <div style="background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px;">
    Ya hay un lote de facturación ejecutándose en segundo plano. Por favor esperá unos segundos y refrescá la página.
  </div>
<% } else if (filtros && filtros.fecha_actualizada) { %>
  <div style="background: #eef8f3; border: 1px solid #c2e9d2; color: #1e5a3a; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px;">
    ✓ Fecha de facturación actualizada correctamente.
  </div>
<% } else if (filtros && filtros.facturada_ok) { %>
  <div style="background: #eef8f3; border: 1px solid #c2e9d2; color: #1e5a3a; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px;">
    ✓ Factura autorizada y emitida con éxito en ARCA con CAE oficial.
  </div>
<% } else if (filtros && filtros.error_facturacion) { %>
  <div style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px;">
    ⚠ ARCA no pudo autorizar el comprobante: <strong><%= decodeURIComponent(filtros.error_facturacion) %></strong>
  </div>
<% } else if (filtros && filtros.error_fecha) { %>
  <div style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px;">
    ⚠ Formato de fecha inválido.
  </div>
<% } else if (filtros && filtros.error_ya_facturada) { %>
  <div style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px;">
    ⚠ No se puede modificar la fecha de una donación que ya fue facturada en ARCA.
  </div>
<% } %>

<div class="page-head">
  <div>
    <h1>Donaciones</h1>
    <p>Donaciones importadas desde Mercado Pago y su estado de facturación.</p>
  </div>
  <div style="display:flex; gap:10px; flex-wrap:wrap;">
    <a href="/exportar/donaciones" class="btn btn--ghost">Exportar a Excel</a>
    <form method="POST" action="/donaciones/procesar-lote" onsubmit="deshabilitarBotonLote(this)">
      <button type="submit" class="btn btn--ghost">Facturar pendientes</button>
    </form>
    <a href="/donaciones/importar" class="btn btn--gold">Importar archivo</a>
  </div>
</div>

<div class="table-wrap">
  <table class="ledger">
    <thead>
      <tr>
        <th>Fecha</th>
        <th>Donante</th>
        <th>Tipo</th>
        <th class="num">Monto</th>
        <th>Estado</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% if (donaciones.length === 0) { %>
        <tr class="empty-row"><td colspan="6">Todavía no se importó ninguna donación. Empezá subiendo el archivo semanal de Mercado Pago.</td></tr>
      <% } %>
      <% donaciones.forEach(d => { %>
        <tr>
          <td>
            <div style="display:flex; align-items:center; gap:6px;">
              <span><%= fecha(d.fecha) %></span>
              <% if (d.estado !== 'facturada') { %>
                <button type="button" 
                        onclick="abrirModalFecha('<%= d.id %>', '<%= d.fecha_iso || '' %>', '<%= (d.donante_nombre || 'Sin identificar').replace(/'/g, '\\\'') %>', '<%= moneda(d.monto) %>')" 
                        style="background:none; border:none; cursor:pointer; font-size:12px; color:#0284c7; padding:2px 4px; border-radius:4px; opacity:0.85;" 
                        title="Modificar fecha fiscal antes de facturar (hasta 10 días atrás)">
                  ✏️
                </button>
              <% } %>
            </div>
          </td>
          <td>
            <div style="font-weight: 500;"><%= d.donante_nombre || 'Sin identificar' %></div>
            <% if (d.donante_cuit) { %>
              <div style="font-size: 11px; color: #64748b; font-family: monospace; margin-top: 2px;"><%= d.donante_cuit %></div>
            <% } %>
          </td>
          <td><%= d.tipo === 'donacion_recurrente' ? 'Recurrente' : 'Puntual' %></td>
          <td class="money"><%= moneda(d.monto) %></td>
          <td>
            <% if (d.estado === 'facturada') { %>
              <span class="estado estado--facturada">Facturada</span>
            <% } else if (d.estado === 'error_facturacion') { %>
              <span class="estado estado--error">Error de ARCA</span>
              <% if (d.error_detalle) { %>
                <div style="font-size: 11px; color: #dc2626; margin-top: 4px; max-width: 260px; line-height: 1.3;"><%= d.error_detalle %></div>
              <% } %>
            <% } else { %>
              <span class="estado estado--pendiente">Pendiente</span>
            <% } %>
          </td>
          <td>
            <% if (d.estado === 'facturada') { %>
              <a href="/donaciones/<%= d.id %>/factura.pdf" class="btn btn--ghost" style="padding:4px 9px; font-size:12px;" target="_blank" title="Ver Factura en PDF">PDF</a>
            <% } else if (d.estado === 'error_facturacion') { %>
              <form method="POST" action="/donaciones/<%= d.id %>/reintentar" onsubmit="deshabilitarReintentar(this)" style="display:inline;">
                <button type="submit" class="btn btn--ghost" style="padding:4px 9px; font-size:12px;">Reintentar</button>
              </form>
            <% } else { %>
              <form method="POST" action="/donaciones/<%= d.id %>/facturar-individual" onsubmit="deshabilitarEmitirIndividual(this)" style="display:inline;">
                <button type="submit" class="btn btn--ghost" style="padding:4px 9px; font-size:12px; color:#0f766e; border-color:#0f766e;" title="Emitir Factura C en ARCA">Emitir</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/paginacion') %>

<!-- MODAL OVERLAY: SELLO FISCAL ARCA -->
<div class="modal-animacion-overlay" id="overlayArcaFacturacion" aria-hidden="true">
  <div class="modal-animacion-card">
    <div class="anim-badge-top arca-badge">
      <span class="pulsing-dot"></span> ARCA • FACTURA ELECTRÓNICA
    </div>
    <div class="anim-title" id="arcaModalTitle">Facturando con ARCA...</div>
    <div class="anim-subtitle" id="arcaModalSubtitle">Punto de Venta 00002 • Comunicación segura con servidores fiscales</div>

    <div class="arca-viewport">
      <div class="arca-radar-pulse"></div>
      <div class="arca-logo-center">🏛️</div>
      <div style="font-size: 13px; font-weight: 600; color: #0f172a;" id="arcaLiveStep">Conectando con WSFE Producción...</div>
      <div style="font-size: 11.5px; color: #64748b; margin-top: 3px;" id="arcaLiveDetail">Validando certificado digital y último número</div>

      <div class="arca-fiscal-stamp" id="arcaStampBadge">
        ✓ RECIBO C AUTORIZADO<br>
        <span style="font-size: 11px; font-weight: 500;">CAE OFICIAL REGISTRADO</span>
      </div>
    </div>

    <div class="anim-progress-bar">
      <div class="anim-progress-bar-fill"></div>
    </div>

    <div class="anim-note-bottom">
      🔒 Transacción fiscal en curso • Por favor aguardá unos segundos
    </div>
  </div>
</div>

<!-- MODAL: EDITAR FECHA DE FACTURACIÓN -->
<div class="modal-animacion-overlay" id="modalEditarFecha" aria-hidden="true">
  <div class="modal-animacion-card" style="max-width: 440px; text-align: left; padding: 26px 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
      <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: #0f172a;">Modificar Fecha de Facturación</h3>
      <button type="button" onclick="cerrarModalFecha()" style="background:none; border:none; font-size:24px; cursor:pointer; color:#64748b; line-height:1;">&times;</button>
    </div>
    
    <p style="font-size: 13px; color: #475569; margin: 0 0 16px 0; line-height: 1.4;">
      Donación de <strong id="modalDonanteNombre" style="color:#0f172a;"></strong> por <strong id="modalDonanteMonto" style="color:#0f766e;"></strong>
    </p>

    <form id="formEditarFecha" method="POST" action="">
      <label style="display:block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 6px;">
        Fecha de emisión fiscal (ARCA):
      </label>
      <input type="date" name="nueva_fecha" id="inputNuevaFecha" required
             style="width: 100%; box-sizing: border-box; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; margin-bottom: 12px; font-family: inherit;">

      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px 12px; font-size: 12px; color: #334155; margin-bottom: 20px; line-height: 1.45;">
        <span style="font-weight: 600; color: #0284c7;">ℹ️ Normativa de ARCA:</span><br>
        • Podés facturar con fecha de hasta <strong>10 días hacia atrás</strong>.<br>
        • Si tiene entre 6 y 10 días de antigüedad, el sistema la autoriza automáticamente como <em>Servicios</em> para cumplir con los plazos de ARCA sin error.
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" onclick="cerrarModalFecha()" class="btn btn--ghost" style="padding: 7px 14px; font-size: 13px;">Cancelar</button>
        <button type="submit" class="btn btn--gold" style="padding: 7px 18px; font-size: 13px;">Guardar Fecha</button>
      </div>
    </form>
  </div>
</div>

<script>
let facturacionEnCurso = false;

function mostrarAnimacionArca(titulo, subtitulo) {
  if (facturacionEnCurso) return false;
  facturacionEnCurso = true;

  const overlay = document.getElementById('overlayArcaFacturacion');
  if (overlay) {
    if (titulo) document.getElementById('arcaModalTitle').innerText = titulo;
    if (subtitulo) document.getElementById('arcaModalSubtitle').innerText = subtitulo;
    overlay.classList.add('active');

    const liveStep = document.getElementById('arcaLiveStep');
    const liveDetail = document.getElementById('arcaLiveDetail');
    const stamp = document.getElementById('arcaStampBadge');

    setTimeout(() => {
      liveStep.innerText = 'Consultando último correlativo en Punto de Venta 00002...';
      liveDetail.innerText = 'Verificando numeración en servidores de ARCA';
    }, 400);

    setTimeout(() => {
      liveStep.innerText = 'Solicitando Código de Autorización Electrónico (CAE)...';
      liveDetail.innerText = 'Generando Recibo C con validez fiscal';
    }, 900);

    setTimeout(() => {
      if (stamp) stamp.classList.add('stamped');
      liveStep.innerText = '¡Comprobante autorizado!';
      liveDetail.innerText = 'Asentando movimiento en Libro de Caja y generando PDF';
    }, 1400);
  }
  return true;
}

function deshabilitarBotonLote(form) {
  const btn = form.querySelector('button');
  if (btn) {
    btn.disabled = true;
    btn.style.opacity = '0.6';
    btn.style.cursor = 'not-allowed';
    btn.innerText = 'Facturando...';
  }
  mostrarAnimacionArca('Emitiendo Recibos C en Lote...', 'Autorizando comprobantes pendientes contra ARCA (AFIP)');
}

function deshabilitarReintentar(form) {
  const btn = form.querySelector('button');
  if (btn) {
    btn.disabled = true;
    btn.style.opacity = '0.6';
    btn.style.cursor = 'not-allowed';
    btn.innerText = 'Reintentando...';
  }
  mostrarAnimacionArca('Reintentando emisión con ARCA...', 'Solicitando CAE oficial para esta donación');
}

function deshabilitarEmitirIndividual(form) {
  const btn = form.querySelector('button');
  if (btn) {
    btn.disabled = true;
    btn.style.opacity = '0.6';
    btn.style.cursor = 'not-allowed';
    btn.innerText = 'Emitiendo...';
  }
  mostrarAnimacionArca('Emitiendo Recibo C en ARCA...', 'Solicitando Código de Autorización Electrónico (CAE)');
}

function abrirModalFecha(id, fechaIso, nombre, monto) {
  const modal = document.getElementById('modalEditarFecha');
  const form = document.getElementById('formEditarFecha');
  const input = document.getElementById('inputNuevaFecha');
  const txtNombre = document.getElementById('modalDonanteNombre');
  const txtMonto = document.getElementById('modalDonanteMonto');

  form.action = '/donaciones/' + id + '/editar-fecha';
  txtNombre.textContent = nombre;
  txtMonto.textContent = monto;
  input.value = fechaIso || new Date().toISOString().slice(0, 10);

  // Límites permitidos: hasta hoy y hasta 10 días hacia atrás
  const hoy = new Date();
  const maxIso = hoy.toISOString().slice(0, 10);
  const minDate = new Date();
  minDate.setDate(minDate.getDate() - 10);
  const minIso = minDate.toISOString().slice(0, 10);

  input.max = maxIso;
  input.min = minIso;

  modal.classList.add('active');
  modal.setAttribute('aria-hidden', 'false');
}

function cerrarModalFecha() {
  const modal = document.getElementById('modalEditarFecha');
  modal.classList.remove('active');
  modal.setAttribute('aria-hidden', 'true');
}

// Cerrar modal al hacer clic en el fondo oscuro
document.getElementById('modalEditarFecha').addEventListener('click', function(e) {
  if (e.target === this) {
    cerrarModalFecha();
  }
});
</script>

<%- include('../partials/footer') %>
