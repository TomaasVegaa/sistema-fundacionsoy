<%- include('../partials/header', { titulo: 'Donaciones', activeNav }) %>

<% if (filtros && filtros.procesado) { %>
  <div style="background: #eef8f3; border: 1px solid #c2e9d2; color: #1e5a3a; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px;">
    Lote procesado: <strong><%= filtros.ok || 0 %></strong> donación(es) facturada(s) con éxito
    <% if (Number(filtros.error) > 0) { %>, <strong><%= filtros.error %></strong> con error (podés reintentarlas con el botón Reintentar o pulsando Facturar pendientes)<% } %>.
  </div>
<% } else if (filtros && filtros.en_proceso) { %>
  <div style="background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px;">
    Ya hay un lote de facturación ejecutándose en segundo plano. Por favor esperá unos segundos y refrescá la página.
  </div>
<% } %>

<div class="page-head">
  <div>
    <h1>Donaciones</h1>
    <p>Donaciones importadas desde Mercado Pago y su estado de facturación.</p>
  </div>
  <div style="display:flex; gap:10px; flex-wrap:wrap;">
    <a href="/exportar/donaciones" class="btn btn--ghost">Exportar a Excel</a>
    <form method="POST" action="/donaciones/procesar-lote" onsubmit="deshabilitarBotonLote(this)">
      <button type="submit" class="btn btn--ghost">Facturar pendientes</button>
    </form>
    <a href="/donaciones/importar" class="btn btn--gold">Importar archivo</a>
  </div>
</div>

<div class="table-wrap">
  <table class="ledger">
    <thead>
      <tr>
        <th>Fecha</th>
        <th>Donante</th>
        <th>Tipo</th>
        <th class="num">Monto</th>
        <th>Estado</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% if (donaciones.length === 0) { %>
        <tr class="empty-row"><td colspan="6">Todavía no se importó ninguna donación. Empezá subiendo el archivo semanal de Mercado Pago.</td></tr>
      <% } %>
      <% donaciones.forEach(d => { %>
        <tr>
          <td><%= fecha(d.fecha) %></td>
          <td>
            <div style="font-weight: 500;"><%= d.donante_nombre || 'Sin identificar' %></div>
            <% if (d.donante_cuit) { %>
              <div style="font-size: 11px; color: #64748b; font-family: monospace; margin-top: 2px;"><%= d.donante_cuit %></div>
            <% } %>
          </td>
          <td><%= d.tipo === 'donacion_recurrente' ? 'Recurrente' : 'Puntual' %></td>
          <td class="money"><%= moneda(d.monto) %></td>
          <td>
            <% if (d.estado === 'facturada') { %>
              <span class="estado estado--facturada">Facturada</span>
            <% } else if (d.estado === 'error_facturacion') { %>
              <span class="estado estado--error">Error de ARCA</span>
              <% if (d.error_detalle) { %>
                <div style="font-size: 11px; color: #dc2626; margin-top: 4px; max-width: 260px; line-height: 1.3;"><%= d.error_detalle %></div>
              <% } %>
            <% } else { %>
              <span class="estado estado--pendiente">Pendiente</span>
            <% } %>
          </td>
          <td>
            <% if (d.estado === 'facturada') { %>
              <a href="/donaciones/<%= d.id %>/factura.pdf" class="btn btn--ghost" style="padding:4px 9px; font-size:12px;" target="_blank" title="Ver Factura en PDF">PDF</a>
            <% } else if (d.estado === 'error_facturacion') { %>
              <form method="POST" action="/donaciones/<%= d.id %>/reintentar" onsubmit="deshabilitarReintentar(this)" style="display:inline;">
                <button type="submit" class="btn btn--ghost" style="padding:4px 9px; font-size:12px;">Reintentar</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/paginacion') %>

<script>
function deshabilitarBotonLote(form) {
  const btn = form.querySelector('button');
  if (btn) {
    btn.disabled = true;
    btn.style.opacity = '0.6';
    btn.style.cursor = 'not-allowed';
    btn.innerText = 'Facturando... por favor espere';
  }
}
function deshabilitarReintentar(form) {
  const btn = form.querySelector('button');
  if (btn) {
    btn.disabled = true;
    btn.style.opacity = '0.6';
    btn.style.cursor = 'not-allowed';
    btn.innerText = 'Reintentando...';
  }
}
</script>

<%- include('../partials/footer') %>
