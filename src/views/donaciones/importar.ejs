<%- include('../partials/header', { titulo: 'Importar donaciones', activeNav }) %>

<div class="page-head">
  <div>
    <h1>Importar archivo de Mercado Pago</h1>
    <p>Subí el archivo semanal (CSV, XLSX o PDF) exportado desde Mercado Pago.</p>
  </div>
</div>

<% if (resumen) { %>
  <div class="aviso aviso--ok">
    Se procesó <strong><%= resumen.archivo %></strong>: <%= resumen.totalFilas %> fila(s) de donación leídas,
    <%= resumen.importadas %> donaciones nuevas, <%= resumen.duplicadas %> ya existían,
    <%= resumen.recurrentesDetectadas %> identificadas como donantes recurrentes.
    <% if (resumen.rendimientos > 0) { %>
      Además se detectaron <%= resumen.rendimientos %> línea(s) de rendimiento financiero de Mercado Pago
      (no son donaciones: se sumaron a caja como ingreso financiero, sin factura ni donante asociado).
    <% } %>
    <% if (resumen.invalidas > 0) { %>
      <%= resumen.invalidas %> fila(s) no se pudieron leer y se descartaron.
    <% } %>
  </div>
  <% if (resumen.formato === 'pdf' && resumen.clasificadasPorDefecto > 0) { %>
    <div class="aviso">
      <%= resumen.clasificadasPorDefecto %> línea(s) del PDF tenían fecha y monto pero no calzaron con
      ninguna frase conocida de Mercado Pago ("pago recibido", "rendimiento", etc.) y se importaron como
      donación por precaución. Convendría revisarlas manualmente en la lista de donaciones — el
      reconocimiento de texto en PDF todavía no está calibrado contra un extracto real de la fundación.
    </div>
  <% } %>
  <div style="display:flex; gap:10px; margin-bottom:24px; flex-wrap:wrap;">
    <a href="/donaciones" class="btn btn--gold">Ver donaciones importadas</a>
    <a href="/donaciones/importar" class="btn btn--ghost">Importar otro archivo</a>
  </div>
<% } %>

<form class="form-card" id="formImportar" method="POST" action="/donaciones/importar" enctype="multipart/form-data" onsubmit="iniciarAnimacionEscaneo(this, event)">
  <div class="field">
    <label for="archivo">Archivo (.csv, .xlsx o .pdf)</label>
    <input type="file" name="archivo" id="archivo" accept=".csv,.xlsx,.xls,.pdf" required onchange="actualizarNombreArchivo(this)">
  </div>
  <button type="submit" id="btnSubmitImportar" class="btn btn--gold">Procesar archivo</button>
</form>

<!-- MODAL OVERLAY: ESCÁNER HOLOGRÁFICO -->
<div class="modal-animacion-overlay" id="overlayEscaneo" aria-hidden="true">
  <div class="modal-animacion-card">
    <div class="anim-badge-top">
      <span class="pulsing-dot"></span> PROCESAMIENTO INTELIGENTE
    </div>
    <div class="anim-title" id="scanModalTitle">Desglosando archivo...</div>
    <div class="anim-subtitle" id="scanModalSubtitle">Analizando transacciones de Mercado Pago y clasificando donaciones</div>

    <div class="scanner-viewport">
      <div class="scanner-laser-beam"></div>
      <div class="scanner-doc-icon">📄</div>
      <div style="font-weight: 600; font-size: 14px; color: #0f172a;" id="scanDocName">documento.xlsx</div>
      <div style="font-size: 12px; color: #64748b; margin-top: 2px;" id="scanLiveStatus">Leyendo registros...</div>

      <div class="scanner-chips-container" id="scanChips">
        <!-- Chips inyectados secuencialmente -->
      </div>
    </div>

    <div class="anim-progress-bar">
      <div class="anim-progress-bar-fill"></div>
    </div>

    <div class="anim-note-bottom">
      🔒 Extracción segura • Por favor no recargues la página
    </div>
  </div>
</div>

<script>
let scanSubmitting = false;

function actualizarNombreArchivo(input) {
  if (input.files && input.files[0]) {
    document.getElementById('scanDocName').innerText = input.files[0].name;
  }
}

function iniciarAnimacionEscaneo(form, e) {
  if (scanSubmitting) return;
  e.preventDefault();
  scanSubmitting = true;

  const btn = document.getElementById('btnSubmitImportar');
  if (btn) {
    btn.disabled = true;
    btn.innerText = 'Procesando...';
  }

  const overlay = document.getElementById('overlayEscaneo');
  overlay.classList.add('active');

  const fileInput = document.getElementById('archivo');
  if (fileInput && fileInput.files && fileInput.files[0]) {
    document.getElementById('scanDocName').innerText = fileInput.files[0].name;
  }

  const chipsContainer = document.getElementById('scanChips');
  chipsContainer.innerHTML = '';

  const liveStatus = document.getElementById('scanLiveStatus');

  const secuencias = [
    { text: '✓ Archivo verificado', delay: 250, status: 'Extrayendo operaciones...' },
    { text: '✓ Detección de montos', delay: 550, status: 'Filtrando comisiones y egresos...' },
    { text: '✓ Control anti-duplicados', delay: 850, status: 'Cruzando con base de datos...' }
  ];

  secuencias.forEach(seq => {
    setTimeout(() => {
      liveStatus.innerText = seq.status;
      const chip = document.createElement('div');
      chip.className = 'scanner-chip chip-success';
      chip.innerText = seq.text;
      chipsContainer.appendChild(chip);
    }, seq.delay);
  });

  // Envío real del formulario tras la animación visual
  setTimeout(() => {
    liveStatus.innerText = 'Guardando en el sistema...';
    form.submit();
  }, 1300);
}
</script>

<div class="section" style="margin-top:32px;">
  <div class="section__head"><h2>Cómo funciona</h2></div>
  <p style="font-size:13.5px; color:var(--ink-soft); max-width:640px;">
    Cada fila se identifica por su referencia de transacción de Mercado Pago (en CSV/XLSX) o por
    el contenido de la línea (en PDF): si el mismo archivo se sube dos veces, las donaciones
    repetidas se descartan automáticamente y no se duplican. Las donaciones quedan en estado
    "pendiente" hasta que se ejecuta la facturación, desde la sección de Donaciones. Los
    rendimientos financieros que Mercado Pago acredita por dejar el saldo invertido se
    identifican aparte y se suman a caja sin pasar por facturación, porque no son donaciones.
  </p>
</div>

<%- include('../partials/footer') %>
