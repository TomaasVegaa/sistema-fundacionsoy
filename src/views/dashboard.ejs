<%- include('partials/header', { titulo: 'Panel', activeNav }) %>

<div class="page-head">
  <div>
    <h1>Panel</h1>
    <p>Estado general de donaciones, facturación y caja.</p>
  </div>
  <a href="/donaciones/importar" class="btn btn--gold">Importar archivo de MP</a>
</div>

<div class="figures">
  <div class="figures__item">
    <div class="figures__label">Saldo de caja</div>
    <div class="figures__value"><%= moneda(saldoActual) %></div>
    <div style="font-size: 11px; color: var(--ink-soft); margin-top: 4px;">Donaciones + Rendimientos</div>
  </div>
  <div class="figures__item">
    <div class="figures__label">Total donado (facturado)</div>
    <div class="figures__value sage"><%= moneda(resumen.total_donado) %></div>
    <div style="font-size: 11px; color: var(--sage); margin-top: 4px;">Facturado en ARCA</div>
  </div>
  <div class="figures__item">
    <div class="figures__label">Donantes distintos</div>
    <div class="figures__value"><%= resumen.cantidad_donantes %></div>
    <div style="font-size: 11px; color: var(--ink-soft); margin-top: 4px;">Registrados en el sistema</div>
  </div>
  <div class="figures__item">
    <div class="figures__label">Facturas pendientes</div>
    <div class="figures__value <%= Number(resumen.facturas_pendientes) > 0 ? 'gold' : '' %>"><%= resumen.facturas_pendientes %></div>
    <div style="font-size: 11px; color: <%= Number(resumen.facturas_pendientes) > 0 ? 'var(--gold)' : 'var(--sage)' %>; margin-top: 4px;">
      <%= Number(resumen.facturas_pendientes) === 0 ? '✓ 0 por emitir' : 'Pendientes de envío' %>
    </div>
  </div>
  <div class="figures__item">
    <div class="figures__label">Facturas con error</div>
    <div class="figures__value <%= Number(resumen.facturas_error) > 0 ? 'rust' : '' %>"><%= resumen.facturas_error %></div>
    <div style="font-size: 11px; color: <%= Number(resumen.facturas_error) > 0 ? 'var(--rust)' : 'var(--sage)' %>; margin-top: 4px;">
      <%= Number(resumen.facturas_error) === 0 ? '✓ 0 con error' : 'Requieren reintento' %>
    </div>
  </div>
</div>

<div class="section">
  <div class="section__head">
    <h2>Ingresos vs. egresos, últimos meses</h2>
  </div>
  <% if (serieMensual.length === 0) { %>
    <p style="color:var(--ink-soft); font-size:14px;">Todavía no hay movimientos de caja para graficar.</p>
  <% } else {
    const max = Math.max(1, ...serieMensual.map(m => Math.max(Number(m.ingresos), Number(m.egresos))));
  %>
  <div class="bars">
    <% serieMensual.forEach(m => { %>
      <div class="bars__month">
        <div class="bars__pair">
          <div class="bars__bar ingreso" style="height: <%= Math.round((Number(m.ingresos)/max)*130) %>px" title="Ingresos <%= moneda(m.ingresos) %>"></div>
          <div class="bars__bar egreso" style="height: <%= Math.round((Number(m.egresos)/max)*130) %>px" title="Egresos <%= moneda(m.egresos) %>"></div>
        </div>
        <div class="bars__label"><%= dayjs(m.mes + '-01').format('MMM YY') %></div>
      </div>
    <% }) %>
  </div>
  <div class="legend">
    <span><i class="ingreso"></i> Ingresos (donaciones facturadas)</span>
    <span><i class="egreso"></i> Egresos</span>
  </div>
  <% } %>
</div>

<div class="section">
  <div class="section__head">
    <h2>Acciones pendientes</h2>
    <% if (pendientes.length === 0 && errores.length === 0) { %>
      <span style="font-size: 13px; color: var(--sage); font-weight: 600;">✓ Todo al día</span>
    <% } %>
  </div>

  <% if (pendientes.length === 0 && errores.length === 0) { %>
    <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: var(--radius); padding: 16px 20px; color: #166534; font-size: 14px; display: flex; align-items: center; gap: 10px;">
      <span style="font-size: 18px;">✓</span>
      <div>
        <strong>No hay donaciones pendientes ni facturas con error.</strong>
        <div style="font-size: 12px; color: #15803d; margin-top: 2px;">Todas las donaciones importadas se encuentran 100% facturadas con CAE de ARCA.</div>
      </div>
    </div>
  <% } %>

  <% if (pendientes.length > 0) { %>
    <div class="table-wrap" style="margin-bottom:14px;">
      <table class="ledger">
        <thead>
          <tr><th>Fecha</th><th>Donante</th><th class="num">Monto</th><th>Estado</th></tr>
        </thead>
        <tbody>
          <% pendientes.forEach(p => { %>
            <tr>
              <td><%= fecha(p.fecha) %></td>
              <td><%= p.donante_nombre || 'Sin identificar' %></td>
              <td class="money"><%= moneda(p.monto) %></td>
              <td><span class="estado estado--pendiente">Pendiente de facturar</span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <a href="/donaciones" class="link" style="font-size:13px; color:var(--gold); text-decoration:none;">Ver todas las donaciones pendientes</a>
  <% } %>

  <% if (errores.length > 0) { %>
    <div class="aviso" style="margin-top:20px;">
      Hay <%= errores.length %> factura(s) con error de ARCA. Revisá el detalle en la sección de Donaciones.
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
