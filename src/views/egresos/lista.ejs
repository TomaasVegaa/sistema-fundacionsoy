<%- include('../partials/header', { titulo: 'Egresos', activeNav }) %>

<div class="page-head">
  <div>
    <h1>Egresos</h1>
    <p>Gastos de la fundación, asociados o no a un evento.</p>
  </div>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div style="background:#fdf2f2; border:1px solid #f8b4b4; color:#9b1c1c; padding:12px 16px; border-radius:6px; margin-bottom:20px; font-size:14px;">
    <%= error %>
  </div>
<% } %>

<div class="section">
  <div class="section__head"><h2>Cargar nuevo egreso</h2></div>
  <form class="form-card" method="POST" action="/egresos" enctype="multipart/form-data">
    <div class="field-row">
      <div class="field">
        <label for="fecha">Fecha</label>
        <input type="date" name="fecha" id="fecha" required>
      </div>
      <div class="field">
        <label for="monto">Monto</label>
        <input type="number" step="0.01" name="monto" id="monto" required>
      </div>
    </div>
    <div class="field">
      <label for="concepto">Concepto</label>
      <input type="text" name="concepto" id="concepto" placeholder="Ej: Alquiler de salón" required>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="categoria">Categoría</label>
        <select name="categoria" id="categoria">
          <option value="evento">Evento</option>
          <option value="administrativo">Administrativo</option>
          <option value="honorarios">Honorarios</option>
          <option value="insumos">Insumos</option>
          <option value="otro">Otro</option>
        </select>
      </div>
      <div class="field">
        <label for="evento_id">Evento asociado (opcional)</label>
        <select name="evento_id" id="evento_id">
          <option value="">Sin evento</option>
          <% eventos.forEach(e => { %>
            <option value="<%= e.id %>"><%= e.nombre %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="field">
      <label for="comprobante">Comprobante (foto o PDF, opcional)</label>
      <input type="file" name="comprobante" id="comprobante" accept="image/*,.pdf">
    </div>
    <button type="submit" class="btn btn--gold">Guardar egreso</button>
  </form>
</div>

<div class="section">
  <div class="section__head"><h2>Listado</h2></div>

  <form class="filters" method="GET" action="/egresos">
    <div class="field">
      <label for="f-categoria">Categoría</label>
      <select name="categoria" id="f-categoria">
        <option value="">Todas</option>
        <% ['evento','administrativo','honorarios','insumos','otro'].forEach(c => { %>
          <option value="<%= c %>" <%= (filtros && filtros.categoria === c) ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="f-evento">Evento</label>
      <select name="evento_id" id="f-evento">
        <option value="">Todos</option>
        <% eventos.forEach(e => { %>
          <option value="<%= e.id %>" <%= (filtros && String(filtros.evento_id) === String(e.id)) ? 'selected' : '' %>><%= e.nombre %></option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="f-desde">Desde</label>
      <input type="date" name="desde" id="f-desde" value="<%= (filtros && filtros.desde) || '' %>">
    </div>
    <div class="field">
      <label for="f-hasta">Hasta</label>
      <input type="date" name="hasta" id="f-hasta" value="<%= (filtros && filtros.hasta) || '' %>">
    </div>
    <button type="submit" class="btn btn--ghost">Filtrar</button>
  </form>

  <div class="table-wrap">
    <table class="ledger">
      <thead>
        <tr>
          <th>Fecha</th>
          <th>Concepto</th>
          <th>Categoría</th>
          <th>Evento</th>
          <th class="num">Monto</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (egresos.length === 0) { %>
          <tr class="empty-row"><td colspan="6">No hay egresos cargados con estos filtros.</td></tr>
        <% } %>
        <% egresos.forEach(e => { %>
          <tr>
            <td><%= fecha(e.fecha) %></td>
            <td><%= e.concepto %></td>
            <td><%= e.categoria || '—' %></td>
            <td><%= e.evento_nombre || '—' %></td>
            <td class="money egreso"><%= moneda(e.monto) %></td>
            <td style="display:flex; gap:8px; align-items:center;">
              <% if (e.comprobante_url) { %>
                <a href="<%= e.comprobante_url %>" class="btn btn--ghost" style="padding:4px 8px; font-size:12px;" target="_blank">Comprobante</a>
              <% } %>
              <form method="POST" action="/egresos/<%= e.id %>/eliminar" style="display:inline;" onsubmit="return confirm('¿Estás seguro de eliminar este egreso? El movimiento de caja será revertido.');">
                <button type="submit" class="btn btn--ghost" style="padding:4px 8px; font-size:12px; color:var(--rust);">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <%- include('../partials/paginacion') %>
</div>

<%- include('../partials/footer') %>
